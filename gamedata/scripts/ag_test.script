--- ag_test: console load/conformity driver for the offline guard, plus flow-integration
--- tests. Dormant until toggled.
---
--- Console:
---   run_string ag_test.run()   toggle the driver; it does everything on its own
---   run_string ag_test.ag_test_inventory_sanitization()   Inventory Guard flow test
---   run_string ag_test.ag_test_inventory_cap()   Inventory Guard walk-cap conformity test
---   run_string ag_test.ag_test_surplus_parity()   xinventory.collect_surplus vs classify+iterate_surplus drop-in proof
---   run_string ag_test.ag_test_torture()   TOGGLE a continuous torture loop (spawns squads + floods/trims every few seconds); run again to stop + clean up
---
--- On start it auto-picks a smart on a level away from the actor (so squads spawn offline
--- and the offline guard actually engages), then every 10s spawns one squad there through
--- SIMBOARD:create_squad and logs a conformity snapshot to alifeguard.log:
---   [DRIVER] spawned=N                          load climbing
---   [CONFORM] cell=L:X:Z count=C                independent per-cell offline count; must
---                                               match the guard's own [DENSITY] pass line
---   [CONFORM] hub=<smart> bodies=B cmd=K protected=P scripted=S named=M
---                                               watch bodies rise then drop to ~max after
---                                               [OFFLINE-CULL]; cmd/protected/named never fall
---   [CONFORM] audit=<smart> npc_info=I(stale J) arriving=A(stale K)
---                                               stale must be 0 after a cull
--- Toggle run() again to stop. Capped at 200 spawned squads.

local pairs, math_floor, string_format, tostring = pairs, math.floor, string.format, tostring
local alife_object, alife, game_graph = alife_object, alife, game_graph
local get_story_id = get_object_story_id
local xlog, xsquad, xlevel, xdata = xlog, xsquad, xlevel, xdata

local log = xlog.get_logger("AG.TEST", { outfile = "alifeguard.log" })

local TICK_SEC = 10
local FEED_MAX = 200
local TIME_EVENT_ID = "ag_test"
local TIME_EVENT_ACTION = "driver"
local SECTIONS = { "stalker_sim_squad_novice", "bandit_sim_squad_novice", "simulation_dog" }

local _active = false
local _target_name = nil
local _spawned = 0
local _section_idx = 0

local _protection_opts = {
    exclude_scripted = false,
    exclude_permanent = true,
    exclude_active_role = true,
    exclude_task_target = true,
}

local function _tip(msg)
    log.info("%s", msg)
    if db and db.actor then news_manager.send_tip(db.actor, msg, nil, nil, 6000) end
end

-- Pick a smart on a level other than the actor's, so spawns land offline and the guard
-- processes them. Returns name + server object, or nil if the world has one level only.
local function _pick_offline_smart(graph, actor_level)
    if not (SIMBOARD and SIMBOARD.smarts_by_names) then return nil end
    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        local gvid = smart.m_game_vertex_id
        local ok = gvid and graph:valid_vertex_id(gvid) and graph:vertex(gvid):level_id() ~= actor_level
        if ok then return name, smart end
    end
    return nil
end

local function _spawn_one(smart, name)
    _section_idx = _section_idx + 1
    local section = SECTIONS[(_section_idx % #SECTIONS) + 1]
    local squad = xsquad.create_squad(smart, section)
    if not squad then return end
    _spawned = _spawned + 1
    log.info("[DRIVER] spawned=%d squad=%d sec=%s smart=%s", _spawned, squad.id, section, name)
end

-- ==================== CONFORMITY SNAPSHOT ====================

local function _bin_offline(squad_id, graph, actor_level, cell_size, counts)
    local squad = alife_object(squad_id)
    if not squad or squad.online then return end
    local body_count = squad:npc_count()
    if body_count == 0 then return end
    local gvid = squad.m_game_vertex_id
    if not gvid or not graph:valid_vertex_id(gvid) then return end
    local level_id = graph:vertex(gvid):level_id()
    if level_id == actor_level then return end
    local pos = squad.position
    if not pos then return end
    local key = level_id .. ":" .. math_floor(pos.x / cell_size) .. ":" .. math_floor(pos.z / cell_size)
    counts[key] = (counts[key] or 0) + body_count
end

local function _log_offline_cells(graph, actor_level, cell_size)
    local counts = {}
    for squad_id in pairs(SIMBOARD.squads) do
        _bin_offline(squad_id, graph, actor_level, cell_size, counts)
    end
    for key, count in pairs(counts) do
        log.info("[CONFORM] cell=%s count=%d", key, count)
    end
end

local function _count_named(squad, commander_id)
    local named = 0
    for member_id in xsquad.iter_member_ids(squad) do
        local se = member_id ~= commander_id and alife_object(member_id)
        if se and (get_story_id(member_id) or xdata.unscriptable_npcs[se:section_name()]) then named = named + 1 end
    end
    return named
end

local function _tally_hub(squad_id, smart_pos, max_dist_sqr, totals)
    local squad = alife_object(squad_id)
    if not squad or not squad.position then return end
    if smart_pos:distance_to_sqr(squad.position) > max_dist_sqr then return end
    totals.bodies = totals.bodies + squad:npc_count()
    totals.cmd = totals.cmd + 1
    totals.protected = totals.protected + (xsquad.is_protected(squad, _protection_opts) and 1 or 0)
    totals.scripted = totals.scripted + (xsquad.is_scripted(squad) and 1 or 0)
    totals.named = totals.named + _count_named(squad, squad:commander_id())
end

local function _log_hub(smart, name, max_dist_sqr)
    local smart_pos = smart.position
    local totals = { bodies = 0, cmd = 0, protected = 0, scripted = 0, named = 0 }
    for squad_id in pairs(SIMBOARD.squads) do
        _tally_hub(squad_id, smart_pos, max_dist_sqr, totals)
    end
    log.info("[CONFORM] hub=%s bodies=%d cmd=%d protected=%d scripted=%d named=%d",
        name, totals.bodies, totals.cmd, totals.protected, totals.scripted, totals.named)
end

local function _audit_table(tbl)
    local total, stale = 0, 0
    for id in pairs(tbl) do
        total = total + 1
        if not alife_object(id) then stale = stale + 1 end
    end
    return total, stale
end

local function _log_audit(smart, name)
    local info_total, info_stale = _audit_table(smart.npc_info or {})
    local arr_total, arr_stale = _audit_table(smart.arriving_npc or {})
    log.info("[CONFORM] audit=%s npc_info=%d(stale %d) arriving=%d(stale %d)",
        name, info_total, info_stale, arr_total, arr_stale)
end

-- ==================== DRIVER ====================

local function _driver_tick()
    ResetTimeEvent(TIME_EVENT_ID, TIME_EVENT_ACTION, TICK_SEC)
    if not _active then return true end
    local sim = alife()
    local graph = game_graph()
    local smart = _target_name and SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[_target_name]
    if not (sim and graph and smart) then return false end
    local actor_level = xlevel.get_actor_level_id()
    if _spawned < FEED_MAX then _spawn_one(smart, _target_name) end
    local cell_size = sim:switch_distance()
    _log_offline_cells(graph, actor_level, cell_size)
    _log_hub(smart, _target_name, cell_size * cell_size)
    _log_audit(smart, _target_name)
    return false
end

--- Toggle the load/conformity driver. Everything runs on its own; nothing else to call.
function run()
    if _active then
        _active = false
        RemoveTimeEvent(TIME_EVENT_ID, TIME_EVENT_ACTION)
        _tip(string_format("ag_test: stopped, spawned %d squads at %s", _spawned, tostring(_target_name)))
        return
    end
    local sim = alife()
    local graph = game_graph()
    if not (sim and graph) then _tip("ag_test: alife not ready") return end
    local actor_level = xlevel.get_actor_level_id()
    local name = _pick_offline_smart(graph, actor_level)
    if not name then _tip("ag_test: no smart on another level (need a non-actor level)") return end
    _active = true
    _target_name = name
    RemoveTimeEvent(TIME_EVENT_ID, TIME_EVENT_ACTION)
    CreateTimeEvent(TIME_EVENT_ID, TIME_EVENT_ACTION, TICK_SEC, _driver_tick)
    _tip(string_format("ag_test: running, feeding %s every %ds (set density_trigger/target low to force a cull)", name, TICK_SEC))
end

-- ==================== FLOW TESTS ====================
-- Self-contained @export console functions named ag_test_<flow>(). Each owns its own
-- setup / inject / action / assert / teardown so repeated runs are idempotent. Tests call
-- the SUT (e.g. trim_npc) directly so timing is deterministic. Output goes to a
-- per-session log file appdata/logs/test_alifeguard_<YYYY-MM-DD>_<HH-MM-SS>.log; xlog with
-- explicit flush per line so the file appears immediately. PASS / FAIL also surfaces as a
-- yellow news_manager tip.

local ipairs, type, next = ipairs, type, next
local math_max, math_min, math_huge = math.max, math.min, math.huge
local xcreature, xinventory, xsmart = xcreature, xinventory, xsmart
local IsStalker, level, alife_release_id = IsStalker, level, alife_release_id

local MOD = "alifeguard"

-- session-cached logger for flow tests; one file per game session, appears immediately on disk
local _flow_log
local function _get_flow_log()
    if _flow_log then return _flow_log end
    local ts = os.date("%Y-%m-%d_%H-%M-%S")
    _flow_log = xlog.get_logger("TEST", { outfile = string_format("test_%s_%s.log", MOD, ts) })
    return _flow_log
end

-- xlog facade methods are plain functions (not OO methods). Call with `.`, not `:`.
local function _log_info(msg, ...)
    _get_flow_log().info(msg, ...)
    xlog.flush_all()
end

local function _flow_tip(msg, ms)
    if db and db.actor then news_manager.send_tip(db.actor, msg, nil, nil, ms or 25000) end
end

-- Pick the nearest online stalker that passes xcreature.is_unscriptable.
local function _pick_npc()
    local actor = db.actor
    if not actor then return nil end
    local actor_pos = actor:position()
    local actor_id = actor:id()
    local best, best_dist = nil, math_huge
    for id, obj in xcreature.online_iter_with_id() do
        if id ~= actor_id and alife_object(id) and IsStalker(obj) and obj:alive()
            and not xcreature.is_unscriptable(obj) then
            local dist = obj:position():distance_to_sqr(actor_pos)
            if dist < best_dist then best, best_dist = obj, dist end
        end
    end
    return best
end

-- alife_create_item returns:
--   single cse userdata for non-ammo
--   array of cse for ammo when t.ammo exceeds box_size (engine splits)
local function _extract_ids(se)
    if not se then return {} end
    local se_type = type(se)
    if se_type == "userdata" then
        local id = (type(se.id) == "function" and se:id()) or se.id
        return id and { id } or {}
    end
    if se_type == "table" then
        if se.id then return { se.id } end
        local ids = {}
        for i = 1, #se do
            local cse = se[i]
            local id = cse and ((type(cse.id) == "function" and cse:id()) or cse.id)
            if id then ids[#ids + 1] = id end
        end
        return ids
    end
    return {}
end

local function _inject(npc, sec, count, ammo)
    local all_ids = {}
    for i = 1, count do
        local se = xinventory.create_item(sec, npc:id(), ammo and { ammo = ammo } or nil)
        local ids = _extract_ids(se)
        if #ids == 0 then
            _log_info("[INJECT WARN] %s #%d create returned type=%s (no ids)", sec, i, type(se))
        end
        for _, id in ipairs(ids) do all_ids[#all_ids + 1] = id end
    end
    return all_ids
end

local function _cleanup(ids)
    local released = 0
    for _, id in ipairs(ids or {}) do
        if alife_object(id) then alife_release_id(id); released = released + 1 end
    end
    return released
end

local function _find_mismatched_ammo(opts)
    local candidates = {
        "ammo_9x18_fmj", "ammo_pkm_100", "ammo_gauss",
        "ammo_5.45x39_fmj", "ammo_12x76_dart", "ammo_5.7x28_ss190",
        "ammo_9x39_pab9", "ammo_7.62x54_7h1",
    }
    for _, sec in ipairs(candidates) do
        if ini_sys:section_exist(sec)
            and xinventory.resolve_ammo_category(sec, opts) == "ammo_not_equipped" then
            return sec
        end
    end
    return nil
end

-- MAX_SCAN_ITEMS mirrors the per-walk cap in ag_inventory_guard.script (local constant there).
local INV_SCAN_CAP = 40
-- Continuous torture loop. Each tick floods TORTURE_TARGETS online stalkers with TORTURE_FLOOD
-- items and trims them, and spawns TORTURE_BATCH squads at the online + offline smart, up to
-- TORTURE_CAP total. Spawned-squad and injected-item ledgers let the loop tear itself down.
local TORTURE_TARGETS  = 20
local TORTURE_FLOOD    = 40
local TORTURE_BATCH    = 4
local TORTURE_CAP      = 160
local TORTURE_TICK_SEC = 5
local _torture_active  = false
local _torture_on      = nil
local _torture_off     = nil
local _torture_squads  = {}
local _torture_items   = {}

-- Collect up to `limit` eligible online stalkers (the scanner's own gate: stalker, alive, no
-- service role, not unscriptable) for the multi-NPC torture harness.
local function _pick_npcs(limit)
    local actor = db.actor
    if not actor then return {} end
    local actor_id = actor:id()
    local out = {}
    for id, obj in xcreature.online_iter_with_id() do
        if id ~= actor_id and alife_object(id) and IsStalker(obj) and obj:alive()
            and next(xsmart.get_npc_roles(obj)) == nil and not xcreature.is_unscriptable(obj) then
            out[#out + 1] = id
            if #out >= limit then break end
        end
    end
    return out
end

-- Online inventory item count (for the cap-boundary assertions).
local function _item_count(npc_id)
    local count = 0
    xinventory.iterate_inventory(npc_id, function(_, item) if item then count = count + 1 end end)
    return count
end

--- Inventory sanitization: ag_inventory_guard.trim_npc end-to-end.
--- Inject 20 medkits + 1 stack of mismatched ammo (200 rounds) into the
--- nearest test-eligible NPC, run trim_npc, assert the per-category release
--- counts match the ceilings in ag_inventory_policy.ltx.
--- @export console
function ag_test_inventory_sanitization()
    local TEST = "inventory_sanitization"
    _log_info("[BEGIN] %s", TEST)

    local npc = _pick_npc()
    if not npc then
        _log_info("[FAIL] %s: no eligible NPC near actor", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": no eligible NPC")
        return
    end
    local npc_id = npc:id()
    local npc_name = npc:name() or "?"
    _log_info("[SETUP] npc=%d name=%s", npc_id, npc_name)

    local opts = xinventory.get_category_opts(npc)
    local before = xinventory.classify(npc, opts)
    _log_info("[SNAPSHOT before] medkit=%d ammo_not_equipped=%d",
        before.medkit or 0, before.ammo_not_equipped or 0)

    local mismatched = _find_mismatched_ammo(opts)
    if not mismatched then
        _log_info("[FAIL] %s: no mismatched ammo section found", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": no mismatched ammo section")
        return
    end

    local INJECT_MEDKIT = 20
    local INJECT_AMMO = 200
    local medkit_ids = _inject(npc, "medkit", INJECT_MEDKIT)
    local ammo_ids = _inject(npc, mismatched, 1, INJECT_AMMO)
    _log_info("[INJECT] medkit ids=%d (requested %d), %s ids=%d (requested 1 stack of %d rounds)",
        #medkit_ids, INJECT_MEDKIT, mismatched, #ammo_ids, INJECT_AMMO)

    -- alife->CInventory sync takes one frame. Defer the assertion by 1 second.
    CreateTimeEvent(0, "ag_test_inv_sanit_phase2", 1, function()
        local npc2 = level.object_by_id(npc_id)
        if not npc2 then
            _log_info("[FAIL] %s: npc went offline before phase 2", TEST)
            _flow_tip("[FAIL] " .. TEST .. ": npc offline")
            _cleanup(medkit_ids); _cleanup(ammo_ids)
            return true
        end

        local opts2 = xinventory.get_category_opts(npc2)
        local mid = xinventory.classify(npc2, opts2)
        local mid_medkit = mid.medkit or 0
        local mid_ammo = mid.ammo_not_equipped or 0
        _log_info("[SNAPSHOT mid] medkit=%d ammo_not_equipped=%d", mid_medkit, mid_ammo)

        local result = ag_inventory_guard.trim_npc(npc2)
        _log_info("[ACTION] trim_npc released=%d dt=%.2fms", result.released, result.dt_ms)
        for cat, count in pairs(result.released_by_category) do
            _log_info("[ACTION]   released %s = %d", cat, count)
        end

        local policy = xinventory.load_policy("alifeguard\\ag_inventory_policy.ltx", { "ag_inventory_policy" })
        local MEDKIT_MAX = policy.ag_inventory_policy.rules.medkit.max
        local expected_medkit_released = math_max(mid_medkit - MEDKIT_MAX, 0)
        local actual_medkit_released = (result.released_by_category.medkit) or 0
        local actual_ammo_released = (result.released_by_category.ammo_not_equipped) or 0
        local expected_medkit_after = math_min(mid_medkit, MEDKIT_MAX)

        local ok_medkit = (actual_medkit_released == expected_medkit_released)
        local ok_ammo = (actual_ammo_released >= 1) and (mid_ammo > 0)

        local summary = string_format(
            "npc=%d %s | medkit %d->%d (released %d, cap %d) | ammo_neq %d (released %d stacks) | dt=%.2fms",
            npc_id, npc_name,
            mid_medkit, expected_medkit_after, actual_medkit_released, MEDKIT_MAX,
            mid_ammo, actual_ammo_released, result.dt_ms)

        _log_info("[SUMMARY] %s", summary)

        if ok_medkit and ok_ammo then
            _log_info("[PASS] %s | %s", TEST, summary)
            _flow_tip(string_format("[PASS] %s\n%s", TEST, summary), 30000)
        else
            local reason = string_format(
                "medkit released=%d expected=%d ok=%s | ammo released=%d expected>=1 (mid=%d) ok=%s",
                actual_medkit_released, expected_medkit_released, tostring(ok_medkit),
                actual_ammo_released, mid_ammo, tostring(ok_ammo))
            _log_info("[FAIL] %s | %s | %s", TEST, summary, reason)
            _flow_tip(string_format("[FAIL] %s\n%s\n%s", TEST, summary, reason), 30000)
        end

        local m_cleaned = _cleanup(medkit_ids)
        local a_cleaned = _cleanup(ammo_ids)
        _log_info("[TEARDOWN] released %d/%d medkit ids, %d/%d ammo ids (others already gone via trim)",
            m_cleaned, #medkit_ids, a_cleaned, #ammo_ids)
        return true
    end)
end

-- Evaluate and report the inventory-cap assertions. Kept out of the deferred closure to hold
-- the closure's cyclomatic complexity down.
local function _report_inventory_cap(before, mid, after, r1, r2)
    local TEST = "inventory_cap"
    if not r1 or not r2 then
        _log_info("[FAIL] %s: trim returned nil (policy not loaded?)", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": trim nil")
        return
    end
    local over_cap  = before > INV_SCAN_CAP
    local truncated = mid > INV_SCAN_CAP
    local converged = after < mid
    local bounded   = r1.dt_ms >= 0 and r2.dt_ms >= 0
    local summary = string_format(
        "before=%d -> mid=%d (rel1=%d dt1=%.3fms) -> after=%d (rel2=%d dt2=%.3fms) cap=%d",
        before, mid, r1.released, r1.dt_ms, after, r2.released, r2.dt_ms, INV_SCAN_CAP)
    _log_info("[SUMMARY] %s", summary)
    if over_cap and truncated and converged and bounded then
        _log_info("[PASS] %s | %s", TEST, summary)
        _flow_tip(string_format("[PASS] %s\n%s", TEST, summary), 30000)
    else
        _log_info("[FAIL] %s | %s | over_cap=%s truncated=%s converged=%s bounded=%s",
            TEST, summary, tostring(over_cap), tostring(truncated), tostring(converged), tostring(bounded))
        _flow_tip(string_format("[FAIL] %s (see log)", TEST), 30000)
    end
end

--- Inventory scan cap: ag_inventory_guard.trim_npc under a laden inventory.
--- Injects 2x the per-walk cap of one over-max category into the nearest eligible NPC so the
--- total exceeds MAX_SCAN_ITEMS, then trims twice. Asserts the first pass is truncated (the NPC
--- is still over the cap after it, so no single trim walked the whole inventory), the second
--- pass releases more (convergence as the tail shifts into the first-N window), and both walks
--- completed with a reported dt. This is the frame-cost bound the cap exists to guarantee.
--- @export console
function ag_test_inventory_cap()
    local TEST = "inventory_cap"
    _log_info("[BEGIN] %s", TEST)

    local npc = _pick_npc()
    if not npc then
        _log_info("[FAIL] %s: no eligible NPC near actor", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": no eligible NPC")
        return
    end
    local npc_id = npc:id()
    _log_info("[SETUP] npc=%d name=%s cap=%d", npc_id, npc:name() or "?", INV_SCAN_CAP)

    local INJECT = INV_SCAN_CAP * 2
    local ids = _inject(npc, "medkit", INJECT)
    if #ids == 0 then
        _log_info("[FAIL] %s: medkit inject produced no items", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": inject failed")
        return
    end
    _log_info("[INJECT] medkit x%d (ids=%d)", INJECT, #ids)

    -- alife->CInventory sync takes one frame. Defer the assertion by 1 second.
    CreateTimeEvent(0, "ag_test_inventory_cap_phase2", 1, function()
        local npc2 = level.object_by_id(npc_id)
        if not npc2 then
            _log_info("[FAIL] %s: npc offline before phase 2", TEST)
            _flow_tip("[FAIL] " .. TEST .. ": npc offline")
            _cleanup(ids)
            return true
        end

        local before = _item_count(npc_id)
        local r1 = ag_inventory_guard.trim_npc(npc2)
        local mid = _item_count(npc_id)
        local r2 = ag_inventory_guard.trim_npc(npc2)
        local after = _item_count(npc_id)
        _report_inventory_cap(before, mid, after, r1, r2)

        local cleaned = _cleanup(ids)
        _log_info("[TEARDOWN] released %d/%d injected ids (others already gone via trim)", cleaned, #ids)
        return true
    end)
end

-- Diff two ordered released streams (each entry { id, cat, sec, unit }); nil on match, else a reason.
local function _stream_diff(ref_stream, new_stream)
    if #ref_stream ~= #new_stream then
        return string_format("stream length ref=%d new=%d", #ref_stream, #new_stream)
    end
    for i = 1, #ref_stream do
        local a, b = ref_stream[i], new_stream[i]
        if a.id ~= b.id or a.cat ~= b.cat or a.sec ~= b.sec or a.unit ~= b.unit then
            return string_format("stream[%d] ref=%s/%s/%s/%s new=%s/%s/%s/%s", i,
                tostring(a.id), tostring(a.cat), tostring(a.sec), tostring(a.unit),
                tostring(b.id), tostring(b.cat), tostring(b.sec), tostring(b.unit))
        end
    end
    return nil
end

-- Diff two post-release count maps over the union of their keys; nil on match, else a reason.
local function _counts_diff(ref_counts, new_counts)
    for k, v in pairs(ref_counts) do
        if (new_counts[k] or 0) ~= v then
            return string_format("counts[%s] ref=%d new=%d", tostring(k), v, new_counts[k] or 0)
        end
    end
    for k, v in pairs(new_counts) do
        if (ref_counts[k] or 0) ~= v then
            return string_format("counts[%s] ref=%d new=%d", tostring(k), ref_counts[k] or 0, v)
        end
    end
    return nil
end

-- Exact parity of two surplus captures, each { stream, counts, hit } (candidate also carries
-- released). Delegates the stream and counts diffs; returns (ok, reason).
local function _compare_surplus(ref, new)
    if new.released ~= #new.stream then
        return false, string_format("collect_surplus released=%d but its stream=%d", new.released, #new.stream)
    end
    local reason = _stream_diff(ref.stream, new.stream) or _counts_diff(ref.counts, new.counts)
    if reason then return false, reason end
    if (ref.hit or false) ~= (new.hit or false) then
        return false, string_format("hit_cap ref=%s new=%s", tostring(ref.hit), tostring(new.hit))
    end
    return true, "identical"
end

--- Surplus-walk parity: xinventory.collect_surplus vs classify + iterate_surplus.
--- Injects an over-max medkit pile (unit=1 partial release) and a multi-stack mismatched-ammo pile
--- (unit>1 multi release) into the nearest eligible NPC, then runs BOTH walkers on the same
--- unreleased inventory with a non-releasing recording callback and asserts they produce the
--- identical released stream (item id, category, section, unit, in m_all order), the identical
--- post-release per-key counts, and the identical hit_cap. The drop-in proof for the trim_npc
--- migration to the single-walk form. Runs read-only (nothing released); injected items cleaned up.
--- @export console
function ag_test_surplus_parity()
    local TEST = "surplus_parity"
    _log_info("[BEGIN] %s", TEST)

    local npc = _pick_npc()
    if not npc then
        _log_info("[FAIL] %s: no eligible NPC near actor", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": no eligible NPC")
        return
    end
    local npc_id = npc:id()
    local npc_name = npc:name() or "?"

    local opts0 = xinventory.get_category_opts(npc)
    local mismatched = _find_mismatched_ammo(opts0)
    if not mismatched then
        _log_info("[FAIL] %s: no mismatched ammo section found", TEST)
        _flow_tip("[FAIL] " .. TEST .. ": no mismatched ammo section")
        return
    end

    -- unit=1 partial-release pile + unit>1 multi-stack pile (mismatched ammo -> ammo_not_equipped, max 0)
    local medkit_ids = _inject(npc, "medkit", 20)
    local ammo_ids = _inject(npc, mismatched, 4, 60)
    local inject_ids = {}
    for _, id in ipairs(medkit_ids) do inject_ids[#inject_ids + 1] = id end
    for _, id in ipairs(ammo_ids) do inject_ids[#inject_ids + 1] = id end
    _log_info("[SETUP] npc=%d name=%s injected medkit=%d ammo=%s (4 stacks x60, ids=%d)",
        npc_id, npc_name, #medkit_ids, mismatched, #ammo_ids)

    -- alife->CInventory sync takes one frame. Defer the comparison by 1 second.
    CreateTimeEvent(0, "ag_test_surplus_parity_phase2", 1, function()
        local npc2 = level.object_by_id(npc_id)
        if not npc2 then
            _log_info("[FAIL] %s: npc offline before phase 2", TEST)
            _flow_tip("[FAIL] " .. TEST .. ": npc offline")
            _cleanup(inject_ids)
            return true
        end

        local opts = xinventory.get_category_opts(npc2)
        local policy = xinventory.load_policy("alifeguard\\ag_inventory_policy.ltx", { "ag_inventory_policy" })
        local rules = policy.ag_inventory_policy.rules

        -- Reference: classify then iterate_surplus, recording only (on_surplus releases nothing).
        local ref_stream = {}
        local ref_counts, ref_hit = xinventory.classify(npc2, opts, rules, INV_SCAN_CAP)
        xinventory.iterate_surplus(npc2, opts, {
            rules = rules, counts = ref_counts, max_items = INV_SCAN_CAP,
            on_surplus = function(item, cat, sec, unit)
                ref_stream[#ref_stream + 1] = { id = item:id(), cat = cat, sec = sec, unit = unit }
                return false
            end,
        })

        -- Candidate: collect_surplus, recording only, on the same untouched inventory.
        local new_stream = {}
        local new_released, new_counts, new_hit = xinventory.collect_surplus(npc2, opts, {
            rules = rules, max_items = INV_SCAN_CAP,
            on_surplus = function(item, cat, sec, unit)
                new_stream[#new_stream + 1] = { id = item:id(), cat = cat, sec = sec, unit = unit }
                return false
            end,
        })

        local ok, reason = _compare_surplus(
            { stream = ref_stream, counts = ref_counts, hit = ref_hit },
            { stream = new_stream, counts = new_counts, hit = new_hit, released = new_released })
        local summary = string_format("npc=%d %s | ref_stream=%d new_stream=%d hit ref=%s new=%s",
            npc_id, npc_name, #ref_stream, #new_stream, tostring(ref_hit), tostring(new_hit))
        _log_info("[SUMMARY] %s", summary)
        if ok then
            _log_info("[PASS] %s | %s", TEST, summary)
            _flow_tip(string_format("[PASS] %s\n%s", TEST, summary), 30000)
        else
            _log_info("[FAIL] %s | %s | %s", TEST, summary, reason)
            _flow_tip(string_format("[FAIL] %s\n%s", TEST, reason), 30000)
        end

        _cleanup(inject_ids)
        return true
    end)
end

-- Pick the first smart on the actor's own level, so its spawns go online near the actor and the
-- Online Guard + Inventory Guard engage.
local function _pick_online_smart(graph, actor_level)
    if not (SIMBOARD and SIMBOARD.smarts_by_names) then return nil end
    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        local gvid = smart.m_game_vertex_id
        if gvid and graph:valid_vertex_id(gvid) and graph:vertex(gvid):level_id() == actor_level then
            return name, smart
        end
    end
    return nil
end

-- Spawn `count` squads at a smart, ledgering their ids for teardown.
local function _torture_spawn(smart, name, count)
    local spawned = 0
    for k = 1, count do
        local squad = xsquad.create_squad(smart, SECTIONS[(k % #SECTIONS) + 1])
        if squad then
            _torture_squads[#_torture_squads + 1] = squad.id
            spawned = spawned + 1
        end
    end
    log.info("[TORTURE] spawned=%d at smart=%s", spawned, name)
    return spawned
end

-- Flood and trim one online NPC; returns its trim dt and whether it hit the walk cap.
local function _torture_flood_one(npc_id)
    local npc = level.object_by_id(npc_id)
    if not npc then return 0, false end
    if not npc:alive() then return 0, false end
    local got = _inject(npc, "medkit", TORTURE_FLOOD)
    for j = 1, #got do _torture_items[#_torture_items + 1] = got[j] end
    local before = _item_count(npc_id)
    local res = ag_inventory_guard.trim_npc(npc)
    if not res then return 0, false end
    return res.dt_ms, before > INV_SCAN_CAP
end

-- One tick of inventory pressure: flood + trim every online eligible stalker, sampling the worst
-- trim cost and how many hit the walk cap.
local function _torture_flood()
    local ids = _pick_npcs(TORTURE_TARGETS)
    local max_dt, capped = 0, 0
    for i = 1, #ids do
        local dt, hit = _torture_flood_one(ids[i])
        if dt > max_dt then max_dt = dt end
        if hit then capped = capped + 1 end
    end
    return max_dt, capped
end

-- One tick of density pressure: spawn a batch at the online and offline smarts, under the cap.
local function _torture_spawn_batch()
    if #_torture_squads >= TORTURE_CAP then return end
    local on_smart = _torture_on and SIMBOARD.smarts_by_names[_torture_on]
    local off_smart = _torture_off and SIMBOARD.smarts_by_names[_torture_off]
    if on_smart then _torture_spawn(on_smart, _torture_on, TORTURE_BATCH) end
    if off_smart then _torture_spawn(off_smart, _torture_off, TORTURE_BATCH) end
end

-- Log the sim load (total squads + bodies) so the spike is visible next to the guards' own
-- [DENSITY] / [OFFLINE-CULL] / [VISIT] lines, which already break down online vs offline per cell.
local function _torture_snapshot()
    local squads, bodies = 0, 0
    for squad_id in pairs(SIMBOARD.squads) do
        local squad = alife_object(squad_id)
        if squad then
            squads = squads + 1
            bodies = bodies + (squad:npc_count() or 0)
        end
    end
    log.info("[TORTURE] load squads=%d bodies=%d spawned_ledger=%d", squads, bodies, #_torture_squads)
end

-- Despawn every squad we spawned that survived (the guards may have culled some) and release
-- every item we injected that survived (the Inventory Guard may have trimmed some).
local function _torture_teardown()
    local spawned_total, items_total = #_torture_squads, #_torture_items
    local removed = 0
    for i = 1, spawned_total do
        local squad = alife_object(_torture_squads[i])
        if squad and xsquad.is_squad(squad) then
            xsquad.remove_squad(squad)
            removed = removed + 1
        end
    end
    local released = 0
    for i = 1, items_total do
        if alife_object(_torture_items[i]) then alife_release_id(_torture_items[i]); released = released + 1 end
    end
    _torture_squads, _torture_items = {}, {}
    log.info("[TORTURE] teardown spawned=%d removed=%d guard_culled=%d | items=%d released=%d guard_trimmed=%d",
        spawned_total, removed, spawned_total - removed, items_total, released, items_total - released)
    _tip(string_format("[TORTURE] done: %d/%d squads survived to teardown, %d/%d items survived (rest handled by guards)",
        removed, spawned_total, released, items_total))
end

-- One torture tick: spawn a batch, flood + trim online stalkers, log the load + worst trim cost.
-- Reschedules itself while active; drops the event once toggled off.
local function _torture_tick()
    ResetTimeEvent(TIME_EVENT_ID, "torture", TORTURE_TICK_SEC)
    if not _torture_active then return true end
    _torture_spawn_batch()
    local max_dt, capped = _torture_flood()
    _torture_snapshot()
    log.info("[TORTURE] tick spawned_ledger=%d items_ledger=%d trim_max=%.3fms capped=%d",
        #_torture_squads, #_torture_items, max_dt, capped)
    return false
end

--- Continuous multi-system torture LOOP (toggle). On: every TORTURE_TICK_SEC it spawns another
--- batch of squads (online near actor + offline on another level) up to a cap, and floods + trims
--- every online stalker, so Online density, Offline density, and Inventory trim run under sustained
--- load. Each tick logs to alifeguard.log next to the guards' own lines. Off (run again): stops and
--- tears down -- despawns surviving spawned squads, releases surviving injected items, and the
--- teardown line shows how many the guards culled/trimmed on their own. Set density_trigger /
--- density_target low in MCM first so the culls fire.
--- @export console
function ag_test_torture()
    if _torture_active then
        _torture_active = false
        RemoveTimeEvent(TIME_EVENT_ID, "torture")
        _torture_teardown()
        return
    end
    local sim, graph = alife(), game_graph()
    if not (sim and graph) then _flow_tip("[FAIL] torture: alife not ready"); return end
    local actor_level = xlevel.get_actor_level_id()
    _torture_on = _pick_online_smart(graph, actor_level)
    _torture_off = _pick_offline_smart(graph, actor_level)
    if not (_torture_on or _torture_off) then _flow_tip("[FAIL] torture: no smarts found"); return end
    _torture_active = true
    _torture_squads, _torture_items = {}, {}
    RemoveTimeEvent(TIME_EVENT_ID, "torture")
    CreateTimeEvent(TIME_EVENT_ID, "torture", TORTURE_TICK_SEC, _torture_tick)
    _tip(string_format("[TORTURE] LOOP on (online=%s offline=%s, every %ds). Run again to stop and clean up.",
        tostring(_torture_on), tostring(_torture_off), TORTURE_TICK_SEC))
end

