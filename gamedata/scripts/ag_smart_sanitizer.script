--- ag_smart_sanitizer: Smart Sanitizer - clamps corrupted already_spawned respawn counters

local pairs, type, string, tostring = pairs, type, string, tostring
local clock, RegisterScriptCallback = os.clock, RegisterScriptCallback
local xlog, xprofiler = xlog, xprofiler

local log = xlog.get_logger("AG.SANITIZE", { outfile = "alifeguard.log" })
local _dbg = false

local last_sanitize_time = 0

local cfg = {
    sanitize_smarts = true,
    sanitize_interval = 300,
    log_level = "WARN",
}

local function load_config()
    local get = ag_mcm and ag_mcm.get_config
    if not get then return end

    cfg.sanitize_smarts = get("sanitize_smarts")
    cfg.sanitize_interval = get("sanitize_interval")
    cfg.log_level = get("log_level")

    log.set_level(cfg.log_level)
    _dbg = log.get_level() >= 5

    log.info("[CONFIG] sanitize=%s interval=%ds log=%s",
        tostring(cfg.sanitize_smarts), cfg.sanitize_interval, cfg.log_level)
end

-- Live spawn count per respawn point: live[respawn_point_id][prop] = squads still carrying that pair.
-- That pair is what already_spawned[prop].num counts (set at smart_terrain.script:1719), so it is the repair target.
local function _collect_live_counts()
    local live = {}
    for squad in xsquad.iterate_squads() do
        local rp = squad.respawn_point_id
        local prop = squad.respawn_point_prop_section
        if rp and prop then
            local by_key = live[rp]
            if not by_key then by_key = {}; live[rp] = by_key end
            by_key[prop] = (by_key[prop] or 0) + 1
        end
    end
    return live
end

-- Repair already_spawned[k] corruption to the live spawn count, not 0 which re-drifts: non-table, non-number num, or num < 0.
-- Healthy positive counts are left untouched; rationale in architecture.md "Smart Sanitizer".
local function _execute_smart_sanitize(smart, live)
    if not smart or not smart.already_spawned then return 0 end
    local fixed = 0
    local name
    local by_key = live[smart.id]
    for k, v in pairs(smart.already_spawned) do
        local fix_msg
        local target = (by_key and by_key[k]) or 0
        if type(v) ~= "table" then
            fix_msg = string.format("value type=%s -> { num=%d } (live=%d)", type(v), target, target)
            smart.already_spawned[k] = { num = target }
        elseif type(v.num) ~= "number" then
            fix_msg = string.format("num type=%s -> %d (live=%d)", type(v.num), target, target)
            v.num = target
        elseif v.num < 0 then
            fix_msg = string.format("num=%d -> %d (live=%d)", v.num, target, target)
            v.num = target
        end
        if fix_msg then
            name = name or smart:name()
            log.warn("[SANITIZE] smart=%s key=%s %s", name, k, fix_msg)
            fixed = fixed + 1
        end
    end
    return fixed
end

local function _execute_sanitize()
    if not SIMBOARD or not SIMBOARD.smarts then
        log.debug("[SANITIZE] SIMBOARD not ready")
        return 0, 0
    end
    local timer = xprofiler.new_if(_dbg):start()
    local live = _collect_live_counts()
    local scanned, fixed = 0, 0
    for _, rec in pairs(SIMBOARD.smarts) do
        scanned = scanned + 1
        fixed = fixed + _execute_smart_sanitize(rec.smrt, live)
    end
    timer:stop()
    log.info("[SANITIZE] scanned=%d fixed=%d [%.2fms]", scanned, fixed, timer:get_ms())
    return scanned, fixed
end

-- Independent of the Online Guard's enabled toggle: state hygiene runs whenever the Smart Sanitizer itself is on.
-- A disabled population guard never leaves save-CTD counters unclamped.
local function actor_on_update()
    if not cfg.sanitize_smarts then return end
    if not db or not db.actor then return end
    local tg = clock()
    if tg - last_sanitize_time < cfg.sanitize_interval then return end
    last_sanitize_time = tg
    _execute_sanitize()
end

-- Fires after STATE_Read, before the alife load burst (bind_stalker.script:200); clamps before try_respawn reads.
local function actor_on_reinit()
    if not cfg.sanitize_smarts then return end
    _execute_sanitize()
end

function on_option_change()
    load_config()
end

function on_game_start()
    load_config()
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_reinit", actor_on_reinit)
    RegisterScriptCallback("on_option_change", on_option_change)
end
